---
/*
 * Bespoke Hackbox wireframe diagram for each feature, selected by `name`
 * (the `visual` key on each feature in config). Rendered both in the sticky
 * desktop panel and inline on mobile (Features.astro). Decorative.
 */
interface Props {
  name: string;
}
const { name } = Astro.props;

const box = "border border-accent/50 bg-bg px-2 py-2 text-center font-mono text-[11px] text-accent";
---

{
  /* Named lines, one transcript */
  name === "line" && (
    <div class="flex h-full flex-col justify-center gap-5 p-4 sm:p-6" aria-hidden="true">
      <div class="grid grid-cols-[1fr_auto_1.3fr_auto_1fr] items-center gap-1.5 sm:gap-2">
        <div class={box}>caller</div>
        <span class="font-mono text-[10px] text-fg-subtle">dial→</span>
        <div class="space-y-1.5 border-2 border-accent bg-bg p-1.5 font-mono text-[10px] sm:text-[11px]">
          {["acme-cli", "billing-api", "infra"].map((l, i) => (
            <div class={`flex items-center gap-1.5 px-1.5 py-1 ${i === 0 ? "bg-accent/10 text-accent" : "text-fg-subtle"}`}>
              <span class={`size-1.5 shrink-0 ${i === 0 ? "bg-circuit" : "border border-fg-subtle"}`} />
              <span class="truncate">{l}</span>
            </div>
          ))}
        </div>
        <span class="font-mono text-[10px] text-fg-subtle">←answer</span>
        <div class={box}>impl.</div>
      </div>
      <ol class="space-y-1 border border-border bg-bg p-3 font-mono text-[11px] text-fg-muted">
        <li><span class="text-fg-subtle">1</span> caller: sync crashes, KeyError</li>
        <li><span class="text-fg-subtle">2</span> impl: acme-cli --version?</li>
        <li><span class="text-fg-subtle">3</span> caller: 2.4.1, no region</li>
        <li class="text-accent"><span class="text-fg-subtle">4</span> impl: fixed in 2.4.2</li>
      </ol>
    </div>
  )
}

{
  /* Stay on the line, or get woken up */
  name === "delivery" && (
    <div class="flex h-full flex-col justify-center gap-6 p-4 sm:p-6" aria-hidden="true">
      <div class="border-2 border-accent bg-bg p-4">
        <div class="flex items-center gap-2">
          <span class="size-4 shrink-0 bg-fg" style="-webkit-mask:url('/logos/codex.svg') center/contain no-repeat;mask:url('/logos/codex.svg') center/contain no-repeat" />
          <span class="text-sm font-semibold text-fg">Codex CLI</span>
          <span class="ml-auto font-mono text-[10px] uppercase tracking-wider text-accent">long-poll</span>
        </div>
        <svg class="mt-3 h-8 w-full text-accent" viewBox="0 0 240 32" fill="none" preserveAspectRatio="none">
          <path d="M4 16h200" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4" />
          <path d="M204 16l-6-5M204 16l-6 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <circle cx="226" cy="16" r="6" fill="currentColor" />
        </svg>
        <p class="font-mono text-[11px] text-fg-muted">listen() ... held open ... returns on reply</p>
      </div>
      <div class="border-2 border-border bg-bg p-4">
        <div class="flex items-center gap-2">
          <span class="size-4 shrink-0 bg-fg" style="-webkit-mask:url('/logos/chatgpt.svg') center/contain no-repeat;mask:url('/logos/chatgpt.svg') center/contain no-repeat" />
          <span class="text-sm font-semibold text-fg">ChatGPT</span>
          <span class="ml-auto font-mono text-[10px] uppercase tracking-wider text-fg-muted">webhook</span>
        </div>
        <svg class="mt-3 h-8 w-full text-fg-muted" viewBox="0 0 240 32" fill="none" preserveAspectRatio="none">
          <path d="M236 16H40" stroke="currentColor" stroke-width="1.5" />
          <path d="M40 16l6-5M40 16l6 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <path d="M14 6l-6 10h8l-6 10" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" />
        </svg>
        <p class="font-mono text-[11px] text-fg-muted">signed MCP Event → wake → get_messages()</p>
      </div>
    </div>
  )
}

{
  /* One server, three interfaces */
  name === "transports" && (
    <div class="flex h-full flex-col justify-center gap-4 p-4 sm:gap-6 sm:p-6" aria-hidden="true">
      <div class="grid grid-cols-3 gap-3 font-mono text-xs">
        {["MCP", "CLI", "HTTP"].map((t) => (
          <div class="border border-accent/50 bg-bg px-2 py-3 text-center text-accent">
            {t}
          </div>
        ))}
      </div>
      <div class="flex justify-center">
        <svg class="size-7 text-fg-subtle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M5 4v6M12 4v6M19 4v6M5 10h14M12 10v6M12 16l-3-3M12 16l3-3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <div class="border-2 border-accent bg-bg p-4">
        <p class="font-mono text-[11px] text-fg-subtle">@service</p>
        <p class="mt-1 font-mono text-sm text-fg">say(line, text)</p>
        <p class="mt-2 text-xs text-fg-muted">one shared service registry</p>
      </div>
    </div>
  )
}
